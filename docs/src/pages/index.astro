---
import DocsLayout from '../layouts/DocsLayout.astro';
import VernacularPanels from '../components/VernacularPanels.astro';
import FeatureCards from '../components/FeatureCards.astro';
import Carousel from '../components/Carousel.astro';
import LevelPicker from '../components/LevelPicker.astro';
import Playground from '../components/Playground.astro';
import ReviewStamp from '../components/ReviewStamp.astro';
import Glossary from '../components/Glossary.astro';
import { siteConfig } from '../../site.config.ts';
// The version shown is the extension's own, so it can never go stale.
import manifest from '../../../manifest.json';

import { Content as Dev, frontmatter as devFm } from '../docs/dev.md';
import { Content as Plain, frontmatter as plainFm } from '../docs/plain.md';
import { Content as Eli5, frontmatter as eli5Fm } from '../docs/eli5.md';

// One source: GUIDE.md / INSTALL.md copied in by scripts/sync-docs.mjs.
const sources = import.meta.glob<{ Content: any }>('../docs/source/*.md', { eager: true });
const guide = sources['../docs/source/guide.md'];
const install = sources['../docs/source/install.md'];

// The extension's own tested logic, loaded unchanged so the playground runs
// the real thing rather than a copy that could drift.
import pureSource from '../../../utils/pure.js?raw';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const shot = (file: string) => `${base}/screenshots/${file}`;

const features = [
  { icon: '🔁', title: 'Translates, not explains', text: 'Select a paragraph of docs or an error and read a plain rewrite of it instead. Exact commands stay exact, in copy boxes.' },
  { icon: '🍼', title: 'Four reading levels', text: 'Like I’m five, new to this, I work with developers, or I build with AI. Change it and press the re-run button.' },
  { icon: '🇬🇷', title: 'English or Greek', text: 'The panel, the answers and the read-aloud voice, in either language.' },
  { icon: '✅', title: 'Do it with me', text: 'Turn instructions into a checklist you tick off, or ask "What do I need first?" before you start.' },
  { icon: '💸', title: 'Free, no key needed', text: 'Works out of the box. Add a free Gemini or Groq key for better or faster answers. A daily check drops models that are gone.' },
  { icon: '🔒', title: 'Asks for little', text: 'Your selection goes only to the AI that answers (OVHcloud, Google or Groq). Keys stay in Chrome’s own storage.' },
];

const slides = [
  { title: 'A TypeError, in plain English', caption: 'Select the error on any page and the panel rewrites it as you watch.', image: shot('slide-result.png'), alt: 'The BlankStare side panel showing a TypeError selected on a page and its plain-English rewrite, with the answering model named underneath.' },
  { title: 'Do it with me', caption: 'Instructions become a checklist you tick off, with every command in a copy box.', image: shot('slide-checklist.png'), alt: 'The panel showing install steps as a tick-box checklist with an npm command in a copy box.' },
  { title: 'The same, in Greek', caption: 'Panel, answers and read-aloud voice switch to Greek with one button.', image: shot('slide-greek.png'), alt: 'The panel with the same answer written in Greek.' },
  { title: 'Your last 20 answers', caption: 'Open any earlier answer again without asking twice.', image: shot('slide-history.png'), alt: 'The panel with the history list open, showing earlier selections with their times.' },
  { title: 'Ready when you are', caption: 'The panel waits in the side of the browser. Select text, or press Alt+Shift+E.', image: shot('slide-welcome.png'), alt: 'The empty panel: "Select any dev text", with hints for select and explain, Alt+Shift+E, and pasting a screenshot.' },
  { title: 'Pick your free AI', caption: 'A 5-step setup: language, reading level, which free AI, and an optional key.', image: shot('slide-setup.png'), alt: 'First-run setup, step 3: Start now with no key (OVHcloud), or a free Google Gemini or Groq key.' },
  { title: 'Settings', caption: 'Everything saves by itself. Keys, voice, how you open it, sites to stay quiet on.', image: shot('slide-settings.png'), alt: 'The Settings page with its cards for language, the free AI, voice, how you open it and extras.' },
];

const playgroundCode = `// Scroll to the bottom and press Run (or Ctrl + Enter).
// Everything above the demo is BlankStare's utils/pure.js, unchanged:
// the same code the extension runs and the test suite checks.

${pureSource.trim()}

// ── Try it ──────────────────────────────────────────────────────────────
// 1. A reply streamed in pieces that split a message in half. The parser
//    keeps the half until the rest arrives, so no word goes missing.
const parser = createSSEParser();
const words = [
  ...parser.push('data: {"choices":[{"delta":{"content":"Your code "}}]}\\n\\ndata: {"choi'),
  ...parser.push('ces":[{"delta":{"content":"tried to use something that is not there."}}]}\\n\\n'),
  ...parser.flush(),
];
console.log(words.join(''));

// 2. Is this Greek? Decides which language to answer in.
console.log(isLikelyGreek('Το αρχείο δεν βρέθηκε'), isLikelyGreek('File not found'));

// 3. Only http(s) links from search results are allowed to become links.
console.log(safeUrl('https://developer.mozilla.org/'), JSON.stringify(safeUrl('javascript:alert(1)')));

// 4. The instructions sent to the AI for Greek, beginner level.
console.log(buildSystemPrompt('el', 'newbie', ''));
`;
---
<DocsLayout title="Overview" home>
  <section class="frame hero reveal" id="top">
    <span class="label">Docs · v{manifest.version}</span>
    <h1 class="hero-title">{siteConfig.projectName}</h1>
    <p class="hero-sub">{siteConfig.description}</p>
    <div class="btns">
      {siteConfig.heroLinks.map((l) => (
        <a class:list={['btn', { primary: l.primary }]} href={l.href}>{l.label}</a>
      ))}
    </div>
    <div class="pills">
      {siteConfig.heroPills.map((t) => (
        <span class="pill"><i></i>{t}</span>
      ))}
    </div>
  </section>

  <LevelPicker />

  <FeatureCards features={features} title="What it does" />
  <Carousel slides={slides} label="Screenshots" />

  <section class="doc-body reveal" id="docs" aria-label="Documentation" data-glossary>
    <VernacularPanels>
      <Fragment slot="dev"><ReviewStamp {...devFm} /><Dev /></Fragment>
      <Fragment slot="plain"><ReviewStamp {...plainFm} /><Plain /></Fragment>
      <Fragment slot="eli5"><ReviewStamp {...eli5Fm} /><Eli5 /></Fragment>
    </VernacularPanels>
  </section>

  {/* No "reveal" on Install and Guide: it waits for part of a section to be on screen, which a long section never reaches. */}
  {install && (
    <section class="doc-body doc-source" id="install" aria-label="Install" data-glossary>
      <install.Content />
    </section>
  )}
  {guide && (
    <section class="doc-body doc-source" id="guide" aria-label="Guide" data-glossary>
      <guide.Content />
    </section>
  )}

  {siteConfig.playground.enabled && <Playground code={playgroundCode} title="Playground: the extension's own logic" />}
  <Glossary />
</DocsLayout>
