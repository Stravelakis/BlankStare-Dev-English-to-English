---
export interface Slide {
  title: string;
  caption: string;
  // Real screenshots belong here (path under /public). Without one, a
  // brand-colored placeholder is shown.
  image?: string;
  alt?: string;
}

interface Props {
  slides?: Slide[];
  label?: string;
  interval?: number;
  id?: string;
}

const defaultSlides: Slide[] = [
  { title: 'Overview', caption: 'Dark, animated docs: the default skin for every published repo.' },
  { title: 'Playground', caption: 'Real code running in the browser, sandboxed, no server needed.' },
  { title: 'Reading levels', caption: 'Dev, English, ELI5. One click apart, generated at release.' },
];

const { slides = defaultSlides, label = 'Showcase', interval = 4200, id = 'showcase' } = Astro.props;
const single = slides.length < 2;
---
<section class="showcase" id={id} aria-labelledby={`${id}-title`}>
  <h2 class="section-title reveal" id={`${id}-title`}>{label}</h2>
  <div
    class="carousel reveal"
    data-carousel
    data-interval={interval}
    {...(single ? { 'data-single': '' } : {})}
    role="region"
    aria-roledescription="carousel"
    aria-label={label}
    tabindex="0"
    style={`--interval:${interval}ms`}
  >
    <div class="carousel-track">
      {slides.map((slide, i) => (
        <div
          class:list={['slide', { 'is-active': i === 0 }]}
          role="group"
          aria-roledescription="slide"
          aria-label={`${i + 1} of ${slides.length}: ${slide.title}`}
          inert={i !== 0}
        >
          <div class="slide-media">
            {slide.image ? (
              <img src={slide.image} alt={slide.alt ?? slide.title} loading="lazy" decoding="async" />
            ) : (
              <div class="slide-art" style={`--i:${i}`} aria-hidden="true"></div>
            )}
          </div>
          <h3>{slide.title}</h3>
          <p>{slide.caption}</p>
        </div>
      ))}
    </div>

    <button class="carousel-arrow prev" type="button" aria-label="Previous slide">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 5l-7 7 7 7" /></svg>
    </button>
    <button class="carousel-arrow next" type="button" aria-label="Next slide">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 5l7 7-7 7" /></svg>
    </button>

    <div class="carousel-dots">
      {slides.map((slide, i) => (
        <button
          class="dot"
          type="button"
          data-index={i}
          aria-label={`Show slide ${i + 1}: ${slide.title}`}
          aria-current={i === 0 ? 'true' : undefined}
        ></button>
      ))}
    </div>
  </div>
</section>

<script>
  function initCarousel(root: HTMLElement) {
    const track = root.querySelector<HTMLElement>('.carousel-track');
    const slides = Array.from(root.querySelectorAll<HTMLElement>('.slide'));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('.dot'));
    if (!track || slides.length < 2) return;

    const interval = Number(root.dataset.interval) || 4200;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    let index = 0;
    let timer = 0;
    let hovered = false;
    let focused = false;
    let inView = false;

    const playing = () => !reduced.matches && !hovered && !focused && inView && !document.hidden;

    const sync = () => {
      clearTimeout(timer);
      timer = 0;
      root.removeAttribute('data-playing');
      if (!playing()) return;
      void root.offsetWidth; // restart the progress-bar animation
      root.setAttribute('data-playing', '');
      timer = window.setTimeout(() => go(index + 1), interval);
    };

    const go = (i: number) => {
      index = (i + slides.length) % slides.length;
      track.style.transform = `translateX(${-index * 100}%)`;
      slides.forEach((slide, si) => {
        slide.toggleAttribute('inert', si !== index);
        slide.classList.toggle('is-active', si === index);
      });
      dots.forEach((dot, di) => {
        if (di === index) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
      sync();
    };

    root.querySelector('.next')?.addEventListener('click', () => go(index + 1));
    root.querySelector('.prev')?.addEventListener('click', () => go(index - 1));
    dots.forEach((dot) => dot.addEventListener('click', () => go(Number(dot.dataset.index))));

    root.addEventListener('pointerenter', (e) => {
      if (e.pointerType !== 'mouse') return;
      hovered = true;
      sync();
    });
    root.addEventListener('pointerleave', () => {
      hovered = false;
      sync();
    });
    root.addEventListener('focusin', (e) => {
      focused = (e.target as HTMLElement).matches(':focus-visible');
      sync();
    });
    root.addEventListener('focusout', (e) => {
      if (root.contains(e.relatedTarget as Node | null)) return;
      focused = false;
      sync();
    });
    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') go(index + 1);
      else if (e.key === 'ArrowLeft') go(index - 1);
      else return;
      e.preventDefault();
    });

    let startX = 0;
    let startY = 0;
    let swiping = false;
    track.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse') return;
      swiping = true;
      startX = e.clientX;
      startY = e.clientY;
    });
    track.addEventListener('pointerup', (e) => {
      if (!swiping) return;
      swiping = false;
      const dx = e.clientX - startX;
      const dy = e.clientY - startY;
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) go(index + (dx < 0 ? 1 : -1));
    });
    track.addEventListener('pointercancel', () => {
      swiping = false;
    });

    new IntersectionObserver(
      ([entry]) => {
        inView = entry.isIntersecting;
        sync();
      },
      { threshold: 0.3 }
    ).observe(root);
    document.addEventListener('visibilitychange', sync);
    reduced.addEventListener('change', sync);

    go(0);
  }

  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach(initCarousel);
</script>
