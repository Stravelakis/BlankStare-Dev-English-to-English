{
  "manifest_version": 3,
  "name": "BlankStare: Dev English to English",
  "short_name": "BlankStare",
  "version": "0.5.0",
  "description": "Zero cost BYOK \u2014 Translate developer docs, error messages, READMEs, and tech jargon into plain English, instantly, while you browse. Bring your own free Groq API key.",
  "permissions": [
    "storage",
    "contextMenus",
    "sidePanel",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+B",
        "mac": "MacCtrl+Shift+B"
      },
      "description": "Open BlankStare panel"
    },
    "explain-selection": {
      "suggested_key": {
        "default": "Alt+Shift+E",
        "mac": "MacCtrl+Shift+E"
      },
      "description": "Queue selected text for explanation"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "options_ui": {
    "page": "settings/settings.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Open BlankStare (Alt+Shift+B)"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/lottie/*.json",
        "fonts/*.woff2",
        "fonts/*.css"
      ],
      "matches": [
        "<all_urls>"
      ],
      "use_dynamic_url": false
    }
  ]
}