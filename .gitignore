# ─────────────────────────────────────────
# DevTranslate — .gitignore
# ─────────────────────────────────────────

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# Editor / IDE files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ⚠️  NEVER commit API keys or secrets
.env
*.env
*.env.local
config.local.js
secrets.js

# Node (not used in this project, but good to have just in case)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# Chrome extension distribution files
# (we build these for the Web Store, but don't track them in git)
*.zip
*.crx
*.pem

# Build / temp output
dist/
build/
.tmp/
