# Secrets — BlankStare has no .env; keys live in the user's browser storage.
.env
.env.*
!.env.example
*.pem
*.key
secrets/
SECRETS/
config.local.js

# Dependencies and build output
# (package-lock.json IS tracked: the docs-site deploy runs `npm ci`.)
node_modules/
dist/
build/
.astro/
.tmp/
npm-debug.log*

# Chrome Web Store upload packages — built per release, never tracked
*.zip
*.crx

# OS and editors
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~
